# Telegram Bot API Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Anthropic Claude API Key (Get yours from https://console.anthropic.com/)
# Uses claude-haiku-4-5 -- the cheapest current Claude model, which is plenty
# for this short, structured idea-generation task.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional rate limits to control API spend (defaults shown below).
# CLAUDE_MAX_CALLS_PER_MINUTE=10
# CLAUDE_MAX_CALLS_PER_DAY=200
